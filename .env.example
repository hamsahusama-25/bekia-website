# Copy to .env before running `docker compose up` (the .env file is git-ignored).
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Password of all demo accounts created by `npm run seed` (development only).
SEED_PASSWORD=EcoLoop@2026

# Business time zone used for "today" and for the monthly target buckets.
APP_TZ=Africa/Cairo
